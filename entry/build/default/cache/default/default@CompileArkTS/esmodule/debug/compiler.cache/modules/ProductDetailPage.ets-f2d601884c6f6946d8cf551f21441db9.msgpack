    parsePrice(priceText) {
        if (!priceText) {
            return 0;
        }
        const cleaned = priceText.replace(/[^\d.]/g, '');
        const value = Number.parseFloat(cleaned);
        if (Number.isNaN(value)) {
            return 0;
        }
        return value;
    }
    formatTimestamp(date) {
        const month = (date.getMonth() + 1).toString().padStart(2, '0');
        const day = date.getDate().toString().padStart(2, '0');
        const hour = date.getHours().toString().padStart(2, '0');
        const minute = date.getMinutes().toString().padStart(2, '0');
        return `${month}/${day} ${hour}:${minute}`;
    }
    pickFootprintDescription() {
        if (!this.product) {
            return '';
        }
        const candidates = [];
        if (typeof this.product.detail === 'string') {
            candidates.push(this.product.detail);
        }
        else if (Array.isArray(this.product.detail)) {
            this.product.detail.forEach((item) => {
                candidates.push(item);
            });
        }
        if (this.product.promotion) {
            candidates.push(this.product.promotion);
        }
        if (this.product.discount) {
            candidates.push(this.product.discount);
        }
        for (let i = 0; i < candidates.length; i++) {
            const text = candidates[i];
            if (text && !text.startsWith('http')) {
                return text;
            }
        }
        return this.product.price ? `ä»·æ ¼ï¼š${this.product.price}` : 'æµè§ˆè®°å½•';
    }
    addFootprintRecord() {
        if (!this.product) {
            return;
        }
        const descriptionText = this.pickFootprintDescription();
        const record = {
            id: Date.now().toString(),
            title: this.product.name,
            description: descriptionText,
            time: this.formatTimestamp(new Date()),
            tag: this.product.promotion ?? 'æµè§ˆ',
            imageUrl: this.product.image_url
        };
        const filtered = this.footprintItems
            ? this.footprintItems.filter((item) => item.title !== record.title)
            : [];
        filtered.unshift(record);
        this.footprintItems = filtered.slice(0, 20);
    }
    addPendingReceiptOrder() {
        if (!this.product) {
            return;
