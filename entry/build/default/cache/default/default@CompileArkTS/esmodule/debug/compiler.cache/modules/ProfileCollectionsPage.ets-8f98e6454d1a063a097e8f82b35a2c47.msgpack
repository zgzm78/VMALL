        { id: 'fav-002', title: 'æ™ºæ…§å± V5 Pro 85\"', description: 'æ˜Ÿé—ªæŠ•å± / 144Hzé«˜åˆ·', time: '2024-04-30 æ”¶è—', imageKey: 'shoppingcart3' },
        { id: 'fav-003', title: 'HUAWEI Pocket 2', description: 'æ—¶å°šå°æŠ˜å æ‰‹æœº', time: '2024-04-18 æ”¶è—', tag: 'é™é‡', imageKey: 'detail1' }
      ]
