                    // è´­ç‰©è½¦å•†å“åˆ—è¡¨
                    Column.pop();
                    // åº•éƒ¨åˆè®¡å’Œç»“ç®—
                    this.CartBottomBar.bind(this)();
                });
            }
        }, If);
        If.pop();
        Column.pop();
    }
    rerender() {
        this.updateDirtyElements();
    }
}
